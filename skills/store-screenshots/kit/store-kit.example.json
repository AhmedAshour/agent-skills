{
  "_comment": "Per-app store-kit config (app_store/store-kit.json). Read by render.mjs and publish-play-listing.mjs. apple{} is read by asc-screenshots.mjs (ASC locale -> render folder).",
  "package": "com.example.app",
  "icon": "assets/icon.png",
  "rawDir": "app_store/raw",
  "play": {
    "locales": [
      {
        "play": "en-US",
        "text": "en-US",
        "images": "en-US"
      },
      {
        "play": "ar",
        "text": "ar",
        "images": "ar-SA"
      }
    ],
    "details": {
      "defaultLanguage": "en-US",
      "contactWebsite": "https://example.com",
      "contactEmail": "support@example.com"
    }
  },
  "apple": {
    "appId": "1234567890",
    "target": "ios-6.9",
    "displayType": "APP_IPHONE_67",
    "locales": {
      "en-US": "en-US",
      "ar-SA": "ar-SA"
    }
  }
}
